# Every value below is optional; the defaults shown are what the service uses
# when the variable is unset. Copy to .env for local overrides.

# --- server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# How much of X-Forwarded-For to believe, as a count of proxy hops in front of
# this process. Required for correct per-client rate limiting behind a platform
# load balancer (Render, Fly, Railway, nginx) — use 1 for exactly one proxy.
#
# Leave false when the process is directly exposed. Avoid "true": it trusts the
# entire forwarded chain, which lets a client spoof its own address by sending
# its own X-Forwarded-For header and rotate it to escape the rate limit.
TRUST_PROXY=false

# --- caching (part b) ---
# How long a completed audit is served from cache. Set to 0 to disable caching.
CACHE_TTL_MS=300000
# Hard cap on cached audits, so memory cannot grow with unique URLs.
CACHE_MAX_ENTRIES=500

# --- timeouts ---
# Budget for the outbound fetch, covering every redirect hop and the body read.
FETCH_TIMEOUT_MS=8000
# Budget for the whole audit: fetch, parse and checks. Must be >= FETCH_TIMEOUT_MS.
AUDIT_TIMEOUT_MS=12000
MAX_REDIRECTS=5
MAX_BODY_BYTES=2000000

# --- concurrency (part a) ---
MAX_CONCURRENT_AUDITS=8
MAX_QUEUED_AUDITS=32
QUEUE_TIMEOUT_MS=5000

# --- rate limiting (part c) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- outbound requests ---
USER_AGENT=url-audit-service/1.0 (+https://github.com/)

# DANGEROUS. Allows auditing private, loopback and link-local addresses, which
# turns the service into an SSRF proxy into its own network. Only ever enable
# this for local testing against a fixture server.
ALLOW_PRIVATE_ADDRESSES=false
